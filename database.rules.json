{
  "rules": {
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },
    "employees": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "planning": {
      "shifts2026": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "shifts2025": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "absences": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      },
      "lastUpdate": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "formations": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'subchef')"
    },
    "pointages": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "arrets_inpak": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "ncp_data": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
