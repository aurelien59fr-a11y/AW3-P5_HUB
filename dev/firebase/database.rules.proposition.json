{
  // =====================================================================
  //  PROPOSITION (phase 2) -- NE PAS PUBLIER SANS VALIDATION D'AURELIEN.
  //  Base : database.rules.json deploye le 30/09/2026 (identique au depot).
  //  Changements :
  //   1. "Membre" = compte connecte ET present dans /users (un compte cree via
  //      l'inscription publique n'a plus acces a rien).
  //   2. Absences : lecture admin / sous-chef / visiteur / editPlanning.
  //   3. Pointages, commentaires Bradford : admin / sous-chef / visiteur.
  //   4. Recrutement : admin seul (lecture ouverte retiree).
  //   5. .validate sur planning, absences, formations, roles.
  //   6. pointages/_test_connexion : admin seul (le test ne sert qu'a l'admin).
  //   7. attestation_equipes : lecture admin + sous-chef (attestations).
  //   8. Index pour les futures requetes par date (arrets, NCP).
  //  10. espace/<uid> : chaque employe lit uniquement ses propres donnees.
  //   9. audit_log : ajout seul par tout membre, lecture admin, aucune
  //      modification d'une entree existante (suppression : admin seul).
  // =====================================================================
  "rules": {
    ".read":  "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin')",
    ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin')",

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        // Ecriture : admin seul (racine). Un utilisateur ne peut pas changer son role.
        "role": { ".validate": "newData.isString() && newData.val().matches(/^(admin|subchef|visiteur|custom|employe)$/)" },
        "editPlanning": { ".validate": "newData.isBoolean()" }
      }
    },

    "employees": {
      ".read": "auth != null && root.child('users').child(auth.uid).exists()",
      "$id": {
        ".validate": "newData.hasChildren(['name'])",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
        "birthday": { ".validate": "newData.isString() && newData.val().length <= 10" }
      }
    },

    "planning": {
      "shifts2025": {
        ".read": "auth != null && root.child('users').child(auth.uid).exists()", ".write": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'subchef') || root.child('users').child(auth.uid).child('editPlanning').val() === true)",
        "$nom": { "$i": { ".validate": "newData.isString() && newData.val().length <= 2000" } }
      },
      "shifts2026": {
        ".read": "auth != null && root.child('users').child(auth.uid).exists()", ".write": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'subchef') || root.child('users').child(auth.uid).child('editPlanning').val() === true)",
        "$nom": { "$i": { ".validate": "newData.isString() && newData.val().length <= 2000" } }
      },
      "shifts2027": {
        ".read": "auth != null && root.child('users').child(auth.uid).exists()", ".write": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'subchef') || root.child('users').child(auth.uid).child('editPlanning').val() === true)",
        "$nom": { "$i": { ".validate": "newData.isString() && newData.val().length <= 2000" } }
      },
      "absences": {
        ".read": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'subchef' || root.child('users').child(auth.uid).child('role').val() === 'visiteur') || root.child('users').child(auth.uid).child('editPlanning').val() === true)",
        ".write": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'subchef') || root.child('users').child(auth.uid).child('editPlanning').val() === true)",
        "$k": {
          ".validate": "newData.hasChildren(['n','a','b','d','t'])",
          "n": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "a": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}\\/[0-9]{2}\\/[0-9]{4}$/)" },
          "b": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}\\/[0-9]{2}\\/[0-9]{4}$/)" },
          "d": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 366" },
          "t": { ".validate": "newData.isString() && newData.val().matches(/^(ziek|verlof|recup)$/)" },
          "y": { ".validate": "newData.isString() && newData.val().matches(/^20[0-9]{2}$/)" },
          "ts": { ".validate": "newData.isNumber()" },
          "$autre": { ".validate": false }
        }
      },
      "extraHistorique": {
        ".read": "auth != null && root.child('users').child(auth.uid).exists()", ".write": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'subchef') || root.child('users').child(auth.uid).child('editPlanning').val() === true)",
        "$i": { ".validate": "newData.isString() && newData.val().length <= 100" }
      },
      "lastUpdate": {
        ".read": "auth != null && root.child('users').child(auth.uid).exists()", ".write": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'subchef') || root.child('users').child(auth.uid).child('editPlanning').val() === true)",
        ".validate": "newData.hasChildren(['at','by'])"
      }
    },

    "formations": {
      ".read": "auth != null && root.child('users').child(auth.uid).exists()",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'subchef')",
      "$id": {
        ".validate": "newData.hasChildren(['titre','date'])",
        "titre": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "date": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
        "lieu": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "notes": { ".validate": "newData.isString() && newData.val().length <= 2000" }
      }
    },

    "pointages": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'subchef' || root.child('users').child(auth.uid).child('role').val() === 'visiteur')"
    },

    "arrets_inpak": { ".read": "auth != null && root.child('users').child(auth.uid).exists()", ".indexOn": ["date"] },
    "ncp_data":     { ".read": "auth != null && root.child('users').child(auth.uid).exists()", ".indexOn": ["created_date_iso"] },
    "bulk_data":    { ".read": "auth != null && root.child('users').child(auth.uid).exists()" },

    "bradford": {
      "comments":  { ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'subchef' || root.child('users').child(auth.uid).child('role').val() === 'visiteur')" },
      "import_ts": { ".read": "auth != null && root.child('users').child(auth.uid).exists()" }
    },

    // MON ESPACE : chaque employe lit SEULEMENT ses propres donnees
    // (absences, pointages, score Bradford), publiees par l'admin.
    // Ecriture : admin seul (racine).
    "espace": {
      "$uid": { ".read": "auth != null && auth.uid === $uid" }
    },

    // Journal des actions sensibles : chaque membre peut AJOUTER une entree a
    // son nom ; personne ne peut MODIFIER une entree existante (le .validate
    // s'applique aussi a l'admin). Seul l'admin peut en supprimer (droit de
    // la racine, qu'un sous-noeud ne peut pas retirer). Lecture : admin seul.
    "audit_log": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$id": {
        ".write": "auth != null && root.child('users').child(auth.uid).exists() && !data.exists()",
        ".validate": "!data.exists() && newData.hasChildren(['action','par','uid','at']) && newData.child('uid').val() === auth.uid",
        "action": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "at": { ".validate": "newData.isString() && newData.val().length <= 40" }
      }
    },

    "attestation_equipes": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'subchef')"
    }

    // recrutement, logbook_notes, sharepoint_*, production : admin seul (racine).
  }
}
